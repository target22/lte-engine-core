# config/lte.env -- runtime bindings for /usr/local/bin/lte (committed).
# Format: KEY=VALUE, optional single/double quotes, NO expansion, allowlisted
# keys only. The process environment overrides every line.
# Values only for non-secrets; secrets are forwarded BY NAME (see below).

LTE_RUNTIME=docker
LTE_ENGINE_DIR=lib/lte
# Phase 2:  LTE_RUNTIME=native  (requires <repo>/.venv from python3.11)
# LTE_NATIVE_BIN_DIR=.venv/bin
# Prebuilt/registry image instead of `lte self build`:
# LTE_IMAGE=registry.internal/lte-cas:rt-<key>

# One CAS per repo. Governance OS keeps the existing store; new repos get
# their own path, e.g. /var/lib/lte/tarahos.git.
CAS_REPO=/var/lib/lte/knowledge.git
CAS_BRANCH=main
CAS_REMOTE_NAME=cas-remote
CAS_REMOTE_URL=git@github.com:target22/logic-trace-egine-git-internal.git

# Host variables forwarded into containers by NAME (space-separated), e.g. the
# two names in:  grep -n API_KEY_ENV_VARS lib/lte/lte/cli/ask.py
LTE_ENV_PASSTHROUGH=
# Network for `container+net` commands (ask). `host` for an LLM on localhost.
# LTE_DOCKER_NETWORK=bridge
